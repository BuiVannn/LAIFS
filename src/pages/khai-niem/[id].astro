---
import Layout from '../../layouts/Layout.astro';
import Quiz from '../../components/Quiz.tsx';
import GiaiThichLai from '../../components/GiaiThichLai.tsx';
import { getCollection, getEntry, render } from 'astro:content';
import { hienThi, tomTat, TEN_TANG } from '../../lib';

export async function getStaticPaths() {
  const ds = (await getCollection('khaiNiem')).filter((k) => hienThi(k) && k.body?.trim());
  return ds.map((k) => ({ params: { id: k.id }, props: { k } }));
}

const { k } = Astro.props;
const d = k.data;
const { Content } = await render(k);
const tatCa = await getCollection('khaiNiem');
const tienQuyet = d.tien_quyet.map((id) => tatCa.find((x) => x.id === id)).filter((x) => x !== undefined).map(tomTat);
const quiz = await getEntry('quiz', k.id);
const cauHoi = quiz && hienThi(quiz) ? quiz.data.cau_hoi : [];
// Câu đã nhúng giữa bài (<CauHoi cau="id/qX" />) thì không lặp lại ở cuối
const giuaBai = new Set([...(k.body ?? '').matchAll(/<CauHoi\s+cau="[^"/]+\/([^"]+)"/g)].map((m) => m[1]));
const cauCuoiBai = cauHoi.filter((c) => !giuaBai.has(c.id));
const baiTap = (await getCollection('baiTap')).filter((b) => b.data.khai_niem === k.id && hienThi(b));
const ytId = (url: string) => new URL(url).searchParams.get('v');
const MUC_DO = { nhap_mon: 'Nhập môn', sau: 'Đào sâu', toan_nang: 'Toán nặng' };
---
<Layout tieuDe={d.ten_vi}>
  <p class="duong-dan"><a href="/">Lộ trình</a> › Tầng {d.tang}: {TEN_TANG[d.tang]}</p>
  <h1>
    {d.ten_vi} {d.ten_en && d.ten_en !== d.ten_vi && <small>({d.ten_en})</small>}
    <span class="muc-do" data-muc-do={JSON.stringify(cauHoi.map((c) => `${k.id}/${c.id}`))}></span>
  </h1>
  {d.trang_thai === 'nhap' && <p class="nhan-nhap">Bản nháp — chưa được duyệt</p>}

  <aside class="the-khai-niem">
    {d.dinh_nghia && <p><b>Định nghĩa.</b> {d.dinh_nghia}</p>}
    {d.truc_giac && <p><b>Hiểu ý.</b> {d.truc_giac}</p>}
    {tienQuyet.length > 0 && (
      <p><b>Cần biết trước:</b> {tienQuyet.map((t, i) => <>{i > 0 && ', '}{t.coTrang ? <a href={`/khai-niem/${t.id}`}>{t.ten}</a> : t.ten}</>)}</p>
    )}
    {d.hieu_nham.length > 0 && (
      <details>
        <summary>Hay hiểu nhầm</summary>
        <ul>{d.hieu_nham.map((h) => <li>{h}</li>)}</ul>
      </details>
    )}
  </aside>

  <article><Content /></article>

  {cauCuoiBai.length > 0 && (
    <section>
      <h2>Trắc nghiệm</h2>
      <p class="nhan">Trả lời xong, chọn <b>chắc chắn</b> hoặc <b>đang đoán</b> — câu đoán sẽ quay lại sớm hơn trong <a href="/on-tap">Ôn hôm nay</a>.</p>
      <Quiz client:visible khaiNiem={k.id} cauHoi={cauCuoiBai} tienQuyet={tienQuyet} />
    </section>
  )}

  <section>
    <h2>Giải thích lại bằng lời của bạn</h2>
    <GiaiThichLai client:visible khaiNiem={k.id} ten={d.ten_vi} yChinh={d.y_chinh} />
  </section>

  {baiTap.length > 0 && (
    <section>
      <h2>Luyện code</h2>
      <ul>
        {baiTap.map((b) => (
          <li><a href={`/bai-tap/${b.id}`}>{b.data.tieu_de}</a> {'●'.repeat(b.data.do_kho)}{'○'.repeat(3 - b.data.do_kho)} <small class="tien-do" data-bai={b.id}></small></li>
        ))}
      </ul>
    </section>
  )}

  {d.tai_lieu.length > 0 && (
    <section>
      <h2>Đào sâu</h2>
      <ul class="tai-lieu">
        {d.tai_lieu.map((t) => (
          <li>
            {t.loai === 'video' && ytId(t.url) && (
              <a href={t.url} target="_blank" rel="noopener"><img src={`https://i.ytimg.com/vi/${ytId(t.url)}/mqdefault.jpg`} alt="" width="160" height="90" loading="lazy" /></a>
            )}
            <div>
              <a href={t.url} target="_blank" rel="noopener"><b>{t.tieu_de}</b></a>
              <br /><small>{t.tac_gia} · {MUC_DO[t.muc_do]} · {t.ngon_ngu.toUpperCase()}{t.moc && ` · ${t.moc}`}</small>
              <p>{t.ghi_chu}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
<script>
  import { doc, theoDoi, ganNhanMucDo } from '../../tien-do';
  ganNhanMucDo();
  const baiTap = () => {
    const td = doc();
    document.querySelectorAll<HTMLElement>('[data-bai]').forEach((el) => {
      el.textContent = td.baiTap[el.dataset.bai!] ? '✓ đã đạt' : '';
    });
  };
  baiTap();
  theoDoi(baiTap);
</script>
