---
import 'katex/dist/katex.min.css';
import '../styles.css';
const { tieuDe } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>" />
    <title>{tieuDe ? `${tieuDe} · Học AI` : 'Học AI'}</title>
  </head>
  <body>
    <header><a href="/" class="logo">🧠 Học AI</a></header>
    <main><slot /></main>
    {import.meta.env.DEV && <footer>Chế độ dev: đang hiện cả bản nháp.</footer>}
  </body>
</html>
